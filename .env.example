# === Discord 設定 ===
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
BIDDING_DISCORD_WEBHOOK_URL=your_bidding_discord_webhook_url_here

# === 爬蟲排程設定 ===
SCRAPE_SCHEDULE_HOUR=8
SCRAPE_SCHEDULE_MINUTE=10
BIDDING_SCHEDULE_HOUR=9
BIDDING_SCHEDULE_MINUTE=0
TRACK_CHECK_HOUR=12
TRACK_CHECK_MINUTE=0

# 每日爬蟲日期範圍（含今天，3 = 滾動近 3 天）
SCRAPE_LOOKBACK_DAYS=3
BIDDING_LOOKBACK_DAYS=3

# 公開招標採購性質（工程,財物,勞務；留空=不限）
# BIDDING_PROC_CATEGORIES=財物,勞務

# Discord 每則訊息 Embed 數（上限 10）
DISCORD_EMBED_BATCH_SIZE=5

# === 篩選關鍵字（逗號分隔）===
FILTER_KEYWORDS=網路設備,資訊設備,通訊設備,路由器,交換器,網路,資通訊,伺服器,防火牆,Switch,Router

# === Chrome 設定 ===
CHROME_HEADLESS=true
PAGE_LOAD_TIMEOUT=90

# === 代理（公司網路需要時再填）===
# HTTP_PROXY=
# HTTPS_PROXY=

# === 應用設定 ===
APP_HOST=127.0.0.1
APP_PORT=8000

# === Docker / NAS（本機可留空）===
# DATA_DIR=/app/data
# CHROMIUM_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
